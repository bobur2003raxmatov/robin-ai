# ================= ROBIN sozlamalari =================
# Bu faylni .env nomi bilan nusxalang va kalitlarni kiriting.

APP_NAME=ROBIN
HOST=127.0.0.1
PORT=8000
# Ishlab chiqarishda albatta o'zgartiring (uzun tasodifiy satr):
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=10080

# Ma'lumotlar bazasi: SQLite (standart) yoki PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./database/robin.db
# DATABASE_URL=postgresql+asyncpg://robin:password@localhost:5432/robin

# ---- AI provayderlar (kamida bittasi kerak) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# ---- Bepul / OpenAI-mos provayderlar (Dashboard → Brain'dan ham kiritiladi) ----
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
# GitHub personal access token (models:read ruxsati bilan)
GITHUB_API_KEY=
# Cloudflare: ACCOUNT_ID:API_TOKEN ko'rinishida
CLOUDFLARE_API_KEY=
HUGGINGFACE_API_KEY=
# Birinchi bo'lib ishlatiladigan provayder: anthropic | openai | gemini
PRIMARY_PROVIDER=anthropic

# ---- Kompyuter boshqaruvi ----
# true: server shu kompyuterda ishlaydi va asboblarni shu yerda bajaradi
LOCAL_EXECUTION=true
# Fayllar bilan ishlash uchun ruxsat etilgan ildiz papkalar (; bilan ajrating). Bo'sh = foydalanuvchi uy papkasi
ALLOWED_ROOTS=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=

# ---- Trading ----
TRADING_MODE=paper
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
MAX_DAILY_LOSS_PCT=3
MAX_POSITION_PCT=10
MAX_RISK_PER_TRADE_PCT=1

# Birinchi ro'yxatdan o'tgan foydalanuvchi avtomatik admin bo'ladi

# ===== Auto-deploy (GitHub webhook) =====
DEPLOY_WEBHOOK_SECRET=
DEPLOY_BRANCH=main
DEPLOY_RESTART=false
DEPLOY_REQUIREMENTS=requirements.txt
# PythonAnywhere (hosting) — API token: Account → API token
PA_API_TOKEN=
PA_USERNAME=
PA_DOMAIN=
PA_HOST=www.pythonanywhere.com
